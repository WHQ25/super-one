# Auto-updater (private repo): GitHub token for electron-updater to fetch releases
# Injected via Vite define → process.env.GH_TOKEN at runtime
UPDATER_TOKEN=

# Auto-updater: enable updater checks in dev mode (skipped by default)
TEST_UPDATER=0

# Claude CLI: simulate Claude not installed (for testing setup flow)
TEST_INSTALL_CLAUDE=0

# Multi-instance: run multiple SuperOne instances with isolated userData
# Each value gets its own `userData/instance-{value}` directory
SUPERONE_INSTANCE=

# Codex: API key for OpenAI Codex integration (optional, can also set in-app)
CODEX_API_KEY=

# Debug: show raw JSON input/output for specific tool blocks in chat UI
# Comma-separated tool names (case-insensitive, partial match). Dev only.
RENDERER_VITE_DEBUG_TOOL_NAMES=
