{
  "name": "@superone/cli",
  "version": "0.0.0",
  "private": true,
  "description": "SuperOne headless node CLI (remote execution environment).",
  "type": "module",
  "bin": {
    "superone": "./bin/superone.mjs"
  },
  "files": [
    "bin",
    "dist/npm",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts start --foreground",
    "start": "tsx src/cli.ts start",
    "pair": "tsx src/cli.ts pair-create",
    "build:dist": "tsx scripts/build-dist.ts",
    "pack:npm": "tsx scripts/pack-npm.ts",
    "publish:npm": "tsx scripts/pack-npm.ts --publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.257",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@superone/acp": "workspace:*",
    "@superone/claude": "workspace:*",
    "@superone/codex": "workspace:*",
    "@superone/cursor": "workspace:*",
    "@superone/opencode": "workspace:*",
    "@superone/runtime": "workspace:*",
    "@superone/shared": "workspace:*",
    "better-sqlite3": "^13.0.1",
    "node-pty": "^1.0.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
