{
  "appId": "hello",
  "name": "Hello",
  "isDev": true,
  "version": "0.1.0",
  "author": { "name": "SuperOne", "url": "https://github.com/WHQ25/super-one" },
  "description": "A simple greeting app",
  "logo": "logo.png",
  "preferWidth": 500,
  "toolSlug": "hello",
  "background": { "entry": "background.html" },
  "permissions": {
    "network": [{ "domain": "cdn.jsdelivr.net", "reason": "Demo external background download" }],
    "fs": [{ "scope": "project", "path": ".", "access": "readwrite", "reason": "Read and write project files" }],
    "media": [
      { "kind": "microphone", "reason": "Demo voice recorder" },
      { "kind": "camera", "reason": "Demo webcam preview & snapshot" }
    ],
    "background": { "reason": "Finish the demo download even when the panel is closed" }
  },
  "templates": {
    "detail": "popovers/detail.html",
    "confirm": "popovers/confirm.html",
    "receipt": "popovers/receipt.html"
  },
  "tools": [
    {
      "name": "show_message",
      "description": "Display a message in the Hello app",
      "runningText": "Displaying message…",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "The message to display" }
        },
        "required": ["text"]
      }
    },
    {
      "name": "confirm_purchase",
      "description": "Propose a purchase that the user must confirm in the app before it completes. The agent provides item_id and suggested_qty; the user may adjust quantity and pick a payment method in the confirm UI.",
      "displayName": "Confirm purchase",
      "runningText": "Placing order…",
      "showResult": true,
      "resultSummaryField": "summary",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": { "type": "string", "description": "Product identifier" },
          "suggested_qty": { "type": "number", "description": "Quantity proposed by the agent" }
        },
        "required": ["item_id", "suggested_qty"]
      },
      "renderer": {
        "intercept": {
          "template": "confirm",
          "inputMerge": "shallow-merge",
          "onCancel": "resolve-empty"
        },
        "result": {
          "template": "receipt",
          "autoExpand": true
        }
      }
    }
  ]
}
