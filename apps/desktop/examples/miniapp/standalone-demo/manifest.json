{
  "appId": "standalone-demo",
  "name": "Standalone Demo",
  "main": "node.js",
  "isDev": true,
  "version": "0.3.0",
  "author": { "name": "SuperOne", "url": "https://github.com/WHQ25/super-one" },
  "description": "Counter app demonstrating Node MiniApp Host tools and result WebViews",
  "preferWidth": 420,
  "toolSlug": "demo",
  "templates": {
    "increment-result": "increment-result.html",
    "simple-result": "simple-result.html",
    "confirm-increment": "confirm-increment.html"
  },
  "tools": [
    {
      "name": "increment",
      "description": "Increment the counter by a given amount (default 1). Renders a custom +N counter card.",
      "runningText": "Incrementing counter…",
      "inputSchema": {
        "type": "object",
        "properties": {
          "by": { "type": "number", "description": "Amount to add (default 1)" }
        }
      },
      "standalone": true,
      "renderer": { "result": { "template": "increment-result" } }
    },
    {
      "name": "confirm_increment",
      "description": "Increment the counter, but ask the user to confirm the amount first. Demonstrates standalone + intercept.",
      "runningText": "Waiting for confirmation…",
      "inputSchema": {
        "type": "object",
        "properties": {
          "by": { "type": "number", "description": "Proposed amount to add" }
        }
      },
      "standalone": true,
      "renderer": {
        "intercept": { "template": "confirm-increment", "onCancel": "resolve-empty" },
        "result": { "template": "increment-result" }
      }
    },
    {
      "name": "read_counter",
      "description": "Read the current counter value. Renders the shared simple-result template.",
      "runningText": "Reading counter…",
      "inputSchema": { "type": "object", "properties": {} },
      "standalone": true,
      "renderer": { "result": { "template": "simple-result" } }
    },
    {
      "name": "reset",
      "description": "Reset the counter to zero. Renders the shared simple-result template.",
      "runningText": "Resetting…",
      "inputSchema": { "type": "object", "properties": {} },
      "standalone": true,
      "renderer": { "result": { "template": "simple-result" } }
    },
    {
      "name": "show_counter",
      "description": "Show the counter value in the app's panel UI. Requires the panel.",
      "displayName": "Show counter",
      "runningText": "Showing in panel…",
      "inputSchema": { "type": "object", "properties": {} }
    }
  ]
}
