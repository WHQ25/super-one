<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What -[SBDisplayToolService swapDisplayWithOptions:completion:] checks. -->
	<key>com.apple.springboard.sbdisplay.service</key>
	<true/>
	<!-- What -[SBSTestAutomationService setDevicePoseOverride:] checks. -->
	<key>com.apple.springboard.testautomation</key>
	<true/>
</dict>
</plist>
