  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty --module-dir ../.. && node ./scripts/chmod-agent-bins.mjs",
    "build:cu-helper": "bash ./native/computer-use-helper/scripts/build.sh dev",
    "build:cu-helper:release": "bash ./native/computer-use-helper/scripts/build.sh release",
    "dev": "bash ./native/computer-use-helper/scripts/build.sh dev && rm -f dev.log event-trace.db && electron-vite dev",
    "dev:cdp": "SUPERONE_E2E=1 electron-vite dev --remoteDebuggingPort ${SUPERONE_CDP_PORT:-9222}",
    "bench": "SUPERONE_BENCH=1 electron-vite dev",
    "bench:agent-events": "bun scripts/bench-agent-event-transport.ts",
    "prepare:mac-optional-deps": "bun install --frozen-lockfile --os=darwin --cpu=x64 && bun install --frozen-lockfile --os=darwin --cpu=arm64",
    "prepare:win-optional-deps": "bun install --frozen-lockfile --os=win32 --cpu=x64 && bun install --frozen-lockfile --os=win32 --cpu=arm64",
    "prepare:linux-optional-deps": "bun install --frozen-lockfile --os=linux --cpu=x64 && bun install --frozen-lockfile --os=linux --cpu=arm64",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:quiet": "vitest run --maxWorkers=50%",
    "doctor": "react-doctor",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test:migration": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron --import ./scripts/register-electron-stub.mjs --experimental-strip-types scripts/test-migration.ts",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:fast": "playwright test",
    "build:app": "electron-vite build && electron-builder --config electron-builder.yml",
    "build:mac": "bun run prepare:mac-optional-deps && electron-vite build && electron-builder --mac --config electron-builder.yml",
    "build:mac-dev": "bun run prepare:mac-optional-deps && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --config electron-builder.yml",
    "build:win": "bun run prepare:win-optional-deps && electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:linux": "bun run prepare:linux-optional-deps && electron-vite build && electron-builder --linux --config electron-builder.yml",
    "storybook": "node ./.storybook/run.mjs dev -p 6006",
    "build-storybook": "node ./.storybook/run.mjs build"
  },
