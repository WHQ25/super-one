{
  "name": "@superone/desktop",
  "version": "0.38.6-alpha",
  "main": "./out/main/index.js",
  "type": "module",
  "license": "BUSL-1.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/WHQ25/super-one.git"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty --module-dir ../.. && chmod +x ../../node_modules/@anthropic-ai/claude-agent-sdk-*/claude 2>/dev/null; chmod +x ../../node_modules/@openai/codex-*/codex* 2>/dev/null || true",
    "dev": "rm -f dev.log event-trace.db && sqlite3 ~/Library/Application\\ Support/super-one/superone.db 'DELETE FROM global_resource_cache' 2>/dev/null; electron-vite dev",
    "prepare:mac-optional-deps": "bun install --frozen-lockfile --os=darwin --cpu=x64 && bun install --frozen-lockfile --os=darwin --cpu=arm64",
    "prepare:win-optional-deps": "bun install --frozen-lockfile --os=win32 --cpu=x64 && bun install --frozen-lockfile --os=win32 --cpu=arm64",
    "prepare:linux-optional-deps": "bun install --frozen-lockfile --os=linux --cpu=x64 && bun install --frozen-lockfile --os=linux --cpu=arm64",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test:migration": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron --experimental-strip-types scripts/test-migration.ts",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:fast": "playwright test",
    "build:app": "electron-vite build && electron-builder --config electron-builder.yml",
    "build:mac": "bun run prepare:mac-optional-deps && electron-vite build && electron-builder --mac --config electron-builder.yml",
    "build:mac-dev": "bun run prepare:mac-optional-deps && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --config electron-builder.yml",
    "build:win": "bun run prepare:win-optional-deps && electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:linux": "bun run prepare:linux-optional-deps && electron-vite build && electron-builder --linux --config electron-builder.yml",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.154",
    "@anthropic-ai/sdk": "^0.93.0",
    "@chenglou/pretext": "^0.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lobehub/icons": "^5.0.1",
    "@lobehub/ui": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.133.0",
    "@streamdown/math": "^1.0.2",
    "@superone/shared": "workspace:*",
    "@superone/ui": "workspace:*",
    "@tiptap/extension-code-block-lowlight": "^3.22.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "bufferutil": "^4.1.0",
    "croner": "^10.0.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "dockview": "^5.2.0",
    "dockview-react": "^5.2.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "fdir": "^6.5.0",
    "fzf": "^0.5.2",
    "i18next": "^26.0.6",
    "ignore": "^7.0.5",
    "katex": "^0.16.38",
    "lowlight": "^3.3.0",
    "mermaid": "^11.12.3",
    "morphdom": "^2.7.8",
    "multicast-dns": "^7.2.5",
    "node-pty": "^1.0.0",
    "pdfjs-dist": "^5.4.624",
    "posthog-js": "^1.369.0",
    "qrcode.react": "^4.2.0",
    "react-day-picker": "^9.14.0",
    "react-i18next": "^17.0.4",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^3.8.1",
    "shiki": "^3.23.0",
    "smol-toml": "^1.6.0",
