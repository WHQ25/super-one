{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "bun": "1.3.9",
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "internal": {
      "extends": "base",
      "distribution": "internal",
      "channel": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761263268"
      }
    }
  }
}
