{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "bun": "1.3.9"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "internal": {
      "extends": "base",
      "distribution": "internal",
      "channel": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    }
  }
}
