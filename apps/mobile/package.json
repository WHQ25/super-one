{
  "name": "@superone/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-camera"]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": ["react-native-webrtc", "react-native-incall-manager"]
      }
    }
  },
  "scripts": {
    "build:chat-view": "bun --cwd ../../packages/chat-view build && bun scripts/build-model-viewer.ts && bun scripts/build-pdf-viewer.ts",
    "eas-build-pre-install": "bun scripts/prepare-eas-install.ts",
    "eas-build-post-install": "bun run build:chat-view",
    "generate:theme": "bun scripts/generate-theme-tokens.ts",
    "generate:voice-cue": "bun scripts/generate-voice-ready-cue.ts",
    "generate:icons": "bun run build:chat-view && bun scripts/generate-file-icons.ts && bun scripts/generate-harness-icons.ts && bun scripts/generate-permission-modes.ts && bun scripts/generate-mention-artwork.ts && bun scripts/generate-mention-brands.ts && bun scripts/generate-provider-brands.ts",
    "check:icons": "bun run build:chat-view && bun scripts/generate-file-icons.ts --check && bun scripts/generate-harness-icons.ts --check && bun scripts/generate-permission-modes.ts --check && bun scripts/generate-mention-artwork.ts --check && bun scripts/generate-mention-brands.ts --check && bun scripts/generate-provider-brands.ts --check",
    "predev": "bun run build:chat-view",
    "dev": "expo start --dev-client",
    "prestart": "bun run build:chat-view",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "rebuild": "bun scripts/rebuild-dev-client.ts",
    "rebuild:ios": "bun scripts/rebuild-dev-client.ts --platform ios",
    "rebuild:android": "bun scripts/rebuild-dev-client.ts --platform android",
    "pretypecheck": "bun run build:chat-view",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "bun run build:chat-view",
    "test": "bun scripts/assert-shared-resolution.ts && bun scripts/assert-release-config.ts && bunx vitest run --config vitest.config.ts && bunx jest",
    "test:components": "bunx jest",
    "prepreview": "bun run build:chat-view",
    "preview": "EXPO_PUBLIC_NATIVE_PREVIEW=1 expo start --dev-client",
    "setup:ui": "bun scripts/maestro.ts --install",
    "test:ui": "bun scripts/maestro.ts"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/react-native-skia": "2.14.0",
    "@superone/chat-core": "workspace:*",
    "@superone/chat-view": "workspace:*",
    "@superone/relay-client": "workspace:*",
    "@superone/shared": "workspace:*",
    "diff": "8.0.3",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-media-library": "~58.0.12",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "lowlight": "^3.3.0",
    "lucide-react-native": "^1.61.0",
    "marked": "16.4.2",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-incall-manager": "4.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webrtc": "124.0.8",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@superone/tsconfig": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/hast": "^3.0.4",
    "@types/react": "~19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "babel-preset-expo": "~58.0.20",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
