    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@superone/tsconfig": "workspace:*",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.0"
  }
