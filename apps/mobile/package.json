{
  "name": "@superone/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:chat-view": "bun --cwd ../../packages/chat-view build",
    "eas-build-pre-install": "bun scripts/prepare-eas-install.ts",
    "eas-build-post-install": "bun run build:chat-view",
    "generate:theme": "bun scripts/generate-theme-tokens.ts",
    "generate:icons": "bun run build:chat-view && bun scripts/generate-file-icons.ts && bun scripts/generate-harness-icons.ts && bun scripts/generate-permission-modes.ts && bun scripts/generate-mention-artwork.ts && bun scripts/generate-mention-brands.ts && bun scripts/generate-provider-brands.ts",
    "check:icons": "bun run build:chat-view && bun scripts/generate-file-icons.ts --check && bun scripts/generate-harness-icons.ts --check && bun scripts/generate-permission-modes.ts --check && bun scripts/generate-mention-artwork.ts --check && bun scripts/generate-mention-brands.ts --check && bun scripts/generate-provider-brands.ts --check",
    "predev": "bun run build:chat-view",
    "dev": "expo start --dev-client",
    "prestart": "bun run build:chat-view",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "pretypecheck": "bun run build:chat-view",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "bun run build:chat-view",
    "test": "bun scripts/assert-shared-resolution.ts && bun scripts/assert-release-config.ts && bunx vitest run --config vitest.config.ts",
    "prepreview": "bun run build:chat-view",
    "preview": "EXPO_PUBLIC_NATIVE_PREVIEW=1 expo start --dev-client",
    "setup:ui": "bun scripts/maestro.ts --install",
    "test:ui": "bun scripts/maestro.ts"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@shopify/react-native-skia": "2.2.12",
    "@superone/chat-core": "workspace:*",
    "@superone/chat-view": "workspace:*",
    "@superone/relay-client": "workspace:*",
    "@superone/shared": "workspace:*",
    "diff": "8.0.3",
    "expo": "~54.0.26",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "lucide-react-native": "^0.563.0",
    "marked": "16.4.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@superone/tsconfig": "workspace:*",
    "@types/react": "^19.2.13",
    "@xmldom/xmldom": "0.8.14",
    "babel-preset-expo": "~54.0.0",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.0"
  }
}
