{
  "name": "super-one",
  "version": "0.62.0",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "node-abi": "4.33.0",
    "vite": "~7.3.1"
  },
  "scripts": {
    "postinstall": "bun --filter @superone/desktop postinstall",
    "check-deps-lock": "node scripts/check-deps-lock.mjs",
    "dev": "bun --filter @superone/desktop dev",
    "dev:cdp": "bun --filter @superone/desktop dev:cdp",
    "bench": "bun --filter @superone/desktop bench",
    "bench:agent-events": "bun --filter @superone/desktop bench:agent-events",
    "dev:web": "bun --filter @superone/web dev",
    "dev:relay": "bun --filter @superone/relay dev",
    "dev:cli": "bun --filter @superone/cli dev",
    "dev:cli:pair": "bun --filter @superone/cli pair",
    "dev:cli:lab": "scripts/remote-cli-local.sh start",
    "dev:cli:lab:stop": "scripts/remote-cli-local.sh stop",
    "dev:cli:lab:restart": "scripts/remote-cli-local.sh restart",
    "dev:cli:lab:status": "scripts/remote-cli-local.sh status",
    "dev:cli:lab:logs": "scripts/remote-cli-local.sh logs",
    "dev:cli:lab:pair": "scripts/remote-cli-local.sh pair",
    "dev:cli:lab:smoke": "scripts/remote-cli-local.sh smoke",
    "dev:cli:lab:fg": "scripts/remote-cli-local.sh fg",
    "dev:cli:docker": "scripts/remote-cli-docker.sh up",
    "dev:cli:docker:smoke": "scripts/remote-cli-docker.sh smoke",
    "dev:cli:docker:forward": "scripts/remote-cli-docker.sh forward",
    "dev:cli:docker:pair": "scripts/remote-cli-docker.sh pair",
    "dev:cli:docker:down": "scripts/remote-cli-docker.sh down",
    "dev:video": "bun --filter @superone/video dev",
    "render:video": "bun --filter @superone/video render",
    "still:video": "bun --filter @superone/video still",
    "deploy:relay": "bun --filter @superone/relay deploy",
    "test:relay": "bun --filter @superone/relay test",
    "test:cli": "bun --filter @superone/cli test",
    "pack:cli": "bun --filter @superone/cli pack:npm",
    "publish:cli": "bun --filter @superone/cli publish:npm",
    "test:runtime": "bun --filter @superone/runtime test",
    "publish:harness": "bun scripts/publish-harness-artifacts.ts",
    "write:app-harness-pins": "bun scripts/write-app-harness-pins.ts",
    "build": "bun --filter @superone/desktop build",
    "build:app": "bun --filter @superone/desktop build:app",
    "build:mac": "bun --filter @superone/desktop build:mac",
    "build:mac-dev": "bun --filter @superone/desktop build:mac-dev",
    "build:win": "bun --filter @superone/desktop build:win",
    "build:linux": "bun --filter @superone/desktop build:linux",
    "preview": "bun --filter @superone/desktop preview",
    "test": "bun --filter @superone/desktop test",
    "test:quiet": "bun --filter @superone/desktop test:quiet",
    "test:watch": "bun --filter @superone/desktop test:watch",
    "test:coverage": "bun --filter @superone/desktop test:coverage",
    "test:e2e": "bun --filter @superone/desktop test:e2e",
    "typecheck": "bun --filter '*' typecheck",
    "typecheck:node": "bun --filter @superone/desktop typecheck:node",
    "typecheck:web": "bun --filter @superone/desktop typecheck:web",
    "storybook": "bun --filter @superone/desktop storybook",
    "build-storybook": "bun --filter @superone/desktop build-storybook"
  },
  "dependencies": {
    "@lobehub/icons": "^5.16.0",
    "@musistudio/llms": "1.0.53",
    "lowlight-mermaid": "^0.0.0",
    "remark-math": "^6.0.0"
  },
  "patchedDependencies": {
    "@xterm/addon-webgl@0.19.0": "patches/@xterm%2Faddon-webgl@0.19.0.patch"
  }
}
