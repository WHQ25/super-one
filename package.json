{
  "name": "super-one",
  "version": "0.20.0-alpha",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "license": "BUSL-1.1",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3 && chmod +x node_modules/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/*/rg 2>/dev/null; chmod +x node_modules/@openai/codex-*/codex* 2>/dev/null || true",
    "dev": "rm -f dev.log event-trace.db && sqlite3 ~/Library/Application\\ Support/super-one/superone.db 'DELETE FROM global_resource_cache' 2>/dev/null; electron-vite dev",
    "prepare:mac-optional-deps": "bun install --frozen-lockfile --os=darwin --cpu=*",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "build:app": "electron-vite build && electron-builder --config electron-builder.yml",
    "build:mac": "bun run prepare:mac-optional-deps && electron-vite build && electron-builder --mac --config electron-builder.yml",
    "build:mac-dev": "bun run prepare:mac-optional-deps && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --config electron-builder.yml",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.101",
    "@chenglou/pretext": "^0.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lobehub/icons": "^5.0.1",
    "@lobehub/ui": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.114.0",
    "@streamdown/math": "^1.0.2",
    "@tiptap/extension-code-block-lowlight": "^3.22.3",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "bufferutil": "^4.1.0",
    "croner": "^10.0.1",
    "date-fns": "^4.1.0",
    "dockview": "^5.2.0",
    "dockview-react": "^5.2.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "katex": "^0.16.38",
    "lowlight": "^3.3.0",
    "mermaid": "^11.12.3",
    "morphdom": "^2.7.8",
    "pdfjs-dist": "^5.4.624",
    "posthog-js": "^1.369.0",
    "qrcode.react": "^4.2.0",
    "react-day-picker": "^9.14.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "smol-toml": "^1.6.0",
    "sonner": "^2.0.7",
    "unzipper": "^0.12.3",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@react-symbols/icons": "^1.3.0",
    "@streamdown/code": "^1.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.3",
    "electron": "^41",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "lucide-react": "^0.563.0",
    "motion": "^12.34.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "rehype-stringify": "^10.0.1",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  }
}
