        {
          "elapsedSeconds": undefined,
          "input": "{"title":"复利计算器","width":620,"height":680,"widget_code":"\\n<div style=\\"padding: 1rem 0;\\">\\n\\n<div style=\\"display: flex; align-items: center; gap: 12px; margin: 0 0 1.25rem;\\">\\n  <label style=\\"font-size: 14px; color: var(--color-text-secondary); min-width: 72px;\\">初始本金</label>\\n  <input type=\\"range\\" min=\\"1000\\" max=\\"1000000\\" value=\\"100000\\" step=\\"1000\\" id=\\"principal\\" style=\\"flex: 1;\\" />\\n  <span style=\\"font-size: 14px; font-weight: 500; min-width: 90px; text-align: right;\\" id=\\"principal-out\\">¥100,000</span>\\n</div>\\n\\n<div style=\\"display: flex; align-items: center; gap: 12px; margin: 0 0 1.25rem;\\">\\n  <label style=\\"font-size: 14px; color: var(--color-text-secondary); min-width: 72px;\\">每月定投</label>\\n  <input type=\\"range\\" min=\\"0\\" max=\\"50000\\" value=\\"1000\\" step=\\"100\\" id=\\"monthly\\" style=\\"flex: 1;\\" />\\n  <span style=\\"font-size: 14px; font-weight: 500; min-width: 90px; text-align: right;\\" id=\\"monthly-out\\">¥1,000</span>\\n</div>\\n\\n<div style=\\"display: flex; align-items: center; gap: 12px; margin: 0 0 1.25rem;\\">\\n  <label style=\\"font-size: 14px; color: var(--color-text-secondary); min-width: 72px;\\">年化利率</label>\\n  <input type=\\"range\\" min=\\"0.1\\" max=\\"20\\" value=\\"7\\" step=\\"0.1\\" id=\\"rate\\" style=\\"flex: 1;\\" />\\n  <span style=\\"font-size: 14px; font-weight: 500; min-width: 90px; text-align: right;\\" id=\\"rate-out\\">7.0%</span>\\n</div>\\n\\n<div style=\\"display: flex; align-items: center; gap: 12px; margin: 0 0 1.5rem;\\">\\n  <label style=\\"font-size: 14px; color: var(--color-text-secondary); min-width: 72px;\\">投资年限</label>\\n  <input type=\\"range\\" min=\\"1\\" max=\\"50\\" value=\\"20\\" step=\\"1\\" id=\\"years\\" style=\\"flex: 1;\\" />\\n  <span style=\\"font-size: 14px; font-weight: 500; min-width: 90px; text-align: right;\\" id=\\"years-out\\">20 年</span>\\n</div>\\n\\n<div style=\\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 1.5rem;\\">\\n  <div style=\\"background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: 1rem;\\">\\n    <div style=\\"font-size: 13px; color: var(--color-text-secondary); margin-bottom: 4px;\\">最终金额</div>\\n    <div style=\\"font-size: 22px; font-weight: 500;\\" id=\\"total\\">¥0</div>\\n  </div>\\n  <div style=\\"background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: 1rem;\\">\\n    <div style=\\"font-size: 13px; color: var(--color-text-secondary); margin-bottom: 4px;\\">总投入</div>\\n    <div style=\\"font-size: 22px; font-weight: 500;\\" id=\\"invested\\">¥0</div>\\n  </div>\\n  <div style=\\"background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: 1rem;\\">\\n    <div style=\\"font-size: 13px; color: var(--color-text-secondary); margin-bottom: 4px;\\">利息收益</div>\\n    <div style=\\"font-size: 22px; font-weight: 500; color: #1D9E75;\\" id=\\"interest\\">¥0</div>\\n  </div>\\n</div>\\n\\n<div style=\\"position: relative; height: 280px;\\">\\n  <canvas id=\\"chart\\"></canvas>\\n</div>\\n\\n</div>\\n\\n<script src=\\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.0/chart.umd.js\\"></script>\\n<script>\\nconst fmt = n => '¥' + Math.round(n).toLocaleString('zh-CN');\\n\\nconst principalEl = document.getElementById('principal');\\nconst monthlyEl = document.getElementById('monthly');\\nconst rateEl = document.getElementById('rate');\\nconst yearsEl = document.getElementById('years');\\n\\nfunction calculate() {\\n  const P = Number(principalEl.value);\\n  const M = Number(monthlyEl.value);\\n  const r = Number(rateEl.value) / 100;\\n  const n = Number(yearsEl.value);\\n  const mr = r / 12;\\n\\n  document.getElementById('principal-out').textContent = fmt(P);\\n  document.getElementById('monthly-out').textContent = fmt(M);\\n  document.getElementById('rate-out').textContent = Number(rateEl.value).toFixed(1) + '%';\\n  document.getElementById('years-out').textContent = n + ' 年';\\n\\n  const labels = [];\\n  const totalData = [];\\n  const investedData = [];\\n\\n  for (let y = 0; y <= n; y++) {\\n    labels.push(y + '年');\\n    const months = y * 12;\\n    let totalVal;\\n    if (mr === 0) {\\n      totalVal = P + M * months;\\n    } else {\\n      totalVal = P * Math.pow(1 + mr, months) + M * ((Math.pow(1 + mr, months) - 1) / mr);\\n    }\\n    totalData.push(Math.round(totalVal));\\n    investedData.push(Math.round(P + M * months));\\n  }\\n\\n  const finalTotal = totalData[totalData.length - 1];\\n  const finalInvested = investedData[investedData.length - 1];\\n  const finalInterest = finalTotal - finalInvested;\\n\\n  document.getElementById('total').textContent = fmt(finalTotal);\\n  document.getElementById('invested').textContent = fmt(finalInvested);\\n  document.getElementById('interest').textContent = fmt(finalInterest);\\n\\n  if (window.myChart) {\\n    window.myChart.data.labels = labels;\\n    window.myChart.data.datasets[0].data = totalData;\\n    window.myChart.data.datasets[1].data = investedData;\\n    window.myChart.update();\\n  }\\n\\n  return { labels, totalData, investedData };\\n}\\n\\nconst initial = calculate();\\n\\nconst ctx = document.getElementById('chart').getContext('2d');\\nconst style = getComputedStyle(document.documentElement);\\nconst textColor = style.getPropertyValue('--color-text-secondary').trim() || '#888780';\\nconst borderColor = style.getPropertyValue('--color-border-tertiary').trim() || 'rgba(0,0,0,0.1)';\\n\\nwindow.myChart = new Chart(ctx, {\\n  type: 'line',\\n  data: {\\n    labels: initial.labels,\\n    datasets: [\\n      {\\n        label: '总金额',\\n        data: initial.totalData,\\n        borderColor: '#1D9E75',\\n        backgroundColor: 'rgba(29, 158, 117, 0.08)',\\n        fill: true,\\n        tension: 0.3,\\n        pointRadius: 0,\\n        pointHitRadius: 10,\\n        borderWidth: 2\\n      },\\n      {\\n        label: '总投入',\\n        data: initial.investedData,\\n        borderColor: '#378ADD',\\n        backgroundColor: 'rgba(55, 138, 221, 0.06)',\\n        fill: true,\\n        tension: 0,\\n        pointRadius: 0,\\n        pointHitRadius: 10,\\n        borderWidth: 2\\n      }\\n    ]\\n  },\\n  options: {\\n    responsive: true,\\n    maintainAspectRatio: false,\\n    interaction: { mode: 'index', intersect: false },\\n    plugins: {\\n      legend: {\\n        position: 'top',\\n        align: 'end',\\n        labels: { color: textColor, usePointStyle: true, pointStyle: 'circle', boxWidth: 8, padding: 16, font: { size: 12 } }\\n      },\\n      tooltip: {\\n        callbacks: {\\n          label: function(ctx) { return ctx.dataset.label + ': ' + fmt(ctx.parsed.y); }\\n        }\\n      }\\n    },\\n    scales: {\\n      x: {\\n        grid: { display: false },\\n        ticks: { color: textColor, font: { size: 11 }, maxTicksLimit: 10 },\\n        border: { color: borderColor }\\n      },\\n      y: {\\n        grid: { color: borderColor },\\n        ticks: {\\n          color: textColor,\\n          font: { size: 11 },\\n          callback: function(v) {\\n            if (v >= 1e8) return (v / 1e8).toFixed(1) + '亿';\\n            if (v >= 1e4) return Math.round(v / 1e4) + '万';\\n            return v;\\n          }\\n        },\\n        border: { display: false }\\n      }\\n    }\\n  }\\n});\\n\\n[principalEl, monthlyEl, rateEl, yearsEl].forEach(el => el.addEventListener('input', calculate));\\n</script>\\n"}",
