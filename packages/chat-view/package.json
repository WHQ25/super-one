{
  "name": "@superone/chat-view",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React DOM chat renderer hosted in a mobile WebView. Receives pre-reduced patches only.",
  "exports": {
    ".": "./src/index.ts",
    "./host-html": "./src/host-html.ts",
    "./terminal-html": "./src/terminal-html.ts",
    "./markdown": "./src/markdown.ts",
    "./TurnDetailSection": "./src/TurnDetailSection.tsx",
    "./presenters/ChatMessage": "./src/presenters/ChatMessage.tsx",
    "./presenters/ChatMessageIndicators": "./src/presenters/ChatMessageIndicators.tsx",
    "./presenters/ClaudeTurnBody": "./src/presenters/ClaudeTurnBody.tsx",
    "./presenters/CodeBlock": "./src/presenters/CodeBlock.tsx",
    "./presenters/CodexTurnView": "./src/presenters/CodexTurnView.tsx",
    "./presenters/CollapsibleOutput": "./src/presenters/CollapsibleOutput.tsx",
    "./presenters/compact-chat-mode": "./src/presenters/compact-chat-mode.ts",
    "./presenters/CopyableMarkdown": "./src/presenters/CopyableMarkdown.tsx",
    "./presenters/duration-format": "./src/presenters/duration-format.ts",
    "./presenters/getAssistantCopyText": "./src/presenters/getAssistantCopyText.ts",
    "./presenters/groupContent": "./src/presenters/groupContent.ts",
    "./presenters/MermaidBlock": "./src/presenters/MermaidBlock.tsx",
    "./presenters/ReasoningBlock": "./src/presenters/ReasoningBlock.tsx",
    "./presenters/SubagentBlock": "./src/presenters/SubagentBlock.tsx",
    "./presenters/TerminalCommandOutput": "./src/presenters/TerminalCommandOutput.tsx",
    "./presenters/tool-block-utils": "./src/presenters/tool-block-utils.ts",
    "./presenters/turn-process-stats": "./src/presenters/turn-process-stats.ts",
    "./presenters/ToolGroup": "./src/presenters/ToolGroup.tsx",
    "./presenters/ToolRow": "./src/presenters/ToolRow.tsx",
    "./presenters/WorkflowBlock": "./src/presenters/WorkflowBlock.tsx"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.terminal.config.ts && bun scripts/embed-host-html.ts",
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@streamdown/code": "^1.0.1",
    "@streamdown/math": "^1.0.2",
    "@superone/shared": "workspace:*",
    "@superone/ui": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^8.0.3",
    "i18next": "^26.0.6",
    "katex": "^0.16.38",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.12.3",
    "react-i18next": "^17.0.4",
    "streamdown": "^2.1.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
