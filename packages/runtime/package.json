{
  "name": "@superone/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electron-free host runtime (session, fs, git, lease, spawn-env, crypto). Always required; harness packages are optional.",
  "exports": {
    ".": "./src/index.ts",
    "./session": "./src/session/index.ts",
    "./session/*": "./src/session/*.ts",
    "./fs": "./src/fs/index.ts",
    "./fs/*": "./src/fs/*.ts",
    "./git": "./src/git/index.ts",
    "./git/*": "./src/git/*.ts",
    "./harness": "./src/harness/index.ts",
    "./harness/*": "./src/harness/*.ts",
    "./lease": "./src/lease/index.ts",
    "./lease/*": "./src/lease/*.ts",
    "./spawn-env": "./src/spawn-env.ts",
    "./crypto": "./src/crypto/index.ts",
    "./crypto/*": "./src/crypto/*.ts",
    "./settings": "./src/settings/index.ts",
    "./settings/*": "./src/settings/*.ts",
    "./sandbox": "./src/sandbox/index.ts",
    "./sandbox/*": "./src/sandbox/*.ts",
    "./automations": "./src/automations/index.ts",
    "./automations/*": "./src/automations/*.ts",
    "./drafts": "./src/drafts/index.ts",
    "./drafts/*": "./src/drafts/*.ts",
    "./llm-proxy": "./src/llm-proxy/index.ts",
    "./llm-proxy/*": "./src/llm-proxy/*.ts",
    "./sqlite": "./src/sqlite.ts",
    "./workspace": "./src/workspace/index.ts",
    "./workspace/*": "./src/workspace/*.ts",
    "./db": "./src/db/index.ts",
    "./db/*": "./src/db/*.ts",
    "./server": "./src/server/index.ts",
    "./server/*": "./src/server/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@superone/shared": "workspace:*",
    "better-sqlite3": "^13.0.1",
    "croner": "^10.0.1",
    "fzf": "^0.5.2",
    "smol-toml": "^1.6.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
