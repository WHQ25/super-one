+/** ML Kit reports points in the rotation-corrected image, before preview cropping. */
+internal object BarcodeCoordinates {
+  fun imageSize(width: Int, height: Int, rotation: Int): Pair<Int, Int> =
+    if (rotation % 180 == 0) width to height else height to width
+
+  fun toPreview(
+    points: List<Int>, imageWidth: Int, imageHeight: Int,
+    previewWidth: Int, previewHeight: Int, fitCenter: Boolean, mirrored: Boolean
+  ): MutableList<Int> {
+    if (imageWidth <= 0 || imageHeight <= 0 || previewWidth <= 0 || previewHeight <= 0) return mutableListOf()
+    val scaleX = previewWidth.toFloat() / imageWidth
+    val scaleY = previewHeight.toFloat() / imageHeight
+    val scale = if (fitCenter) min(scaleX, scaleY) else max(scaleX, scaleY)
+    val offsetX = (previewWidth - imageWidth * scale) / 2f
+    val offsetY = (previewHeight - imageHeight * scale) / 2f
+    val mapped = mutableListOf<Int>()
+    for (index in 0 until points.size - 1 step 2) {
+      val x = points[index] * scale + offsetX
+      val y = points[index + 1] * scale + offsetY
+      mapped.add((if (mirrored) previewWidth - x else x).roundToInt())
+      mapped.add(y.roundToInt())
+    }
+    return mapped
+  }
+}
